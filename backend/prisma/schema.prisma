generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum UserRole {
  OWNER
  EMPLOYEE
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  INACTIVE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  RESIGNED
}

enum AuthTokenPurpose {
  ACCOUNT_ACTIVATION
  PASSWORD_RESET
  REFRESH_TOKEN
}

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
  MANUAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SalesReportStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  PAID
}

enum PaymentMethod {
  TRANSFER_BANK
  CASH
  EWALLET
}

enum NotificationType {
  SCHEDULE
  ATTENDANCE
  LEAVE
  SALES
  BONUS
  PAYROLL
  SYSTEM
}

enum FileCategory {
  ATTENDANCE_SELFIE
  LEAVE_ATTACHMENT
  SALES_DOCUMENT
  SALES_SCREENSHOT
  PAYMENT_PROOF
  PROFILE_PHOTO
  OTHER
}

// ─── MODELS ──────────────────────────────────────────

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(255)
  passwordHash    String?    @map("password_hash")
  role            UserRole
  status          UserStatus @default(PENDING_ACTIVATION)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  employee      Employee?
  authTokens    AuthToken[]
  notifications Notification[]
  auditLogs     AuditLog[]     @relation("ActorAuditLogs")
  files         File[]

  @@map("users")
}

model Employee {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @unique @map("user_id") @db.Uuid
  code             String           @unique @db.VarChar(30)
  fullName         String           @map("full_name") @db.VarChar(150)
  phone            String?          @db.VarChar(25)
  address          String?
  joinDate         DateTime         @map("join_date") @db.Date
  resignDate       DateTime?        @map("resign_date") @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  profilePhotoId   String?          @map("profile_photo_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user                User                 @relation(fields: [userId], references: [id])
  profilePhoto        File?                @relation("EmployeeProfilePhoto", fields: [profilePhotoId], references: [id])
  shiftRates          EmployeeShiftRate[]
  scheduleAssignments ScheduleAssignment[]
  leaveRequests       LeaveRequest[]
  salesReports        SalesReport[]
  bonusDetails        BonusDetail[]
  payrolls            Payroll[]

  @@map("employees")
}

model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tokenHash String           @map("token_hash")
  purpose   AuthTokenPurpose
  expiresAt DateTime         @map("expires_at") @db.Timestamptz
  usedAt    DateTime?        @map("used_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("auth_tokens")
}

model EmployeeShiftRate {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  ratePerShift  BigInt    @map("rate_per_shift")
  sickPayPerDay BigInt    @map("sick_pay_per_day")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdBy     String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_shift_rates")
}

model Shift {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(50)
  startTime    String   @map("start_time") @db.VarChar(5)
  endTime      String   @map("end_time") @db.VarChar(5)
  maxEmployees Int      @default(2) @map("max_employees")
  color        String   @default("#2563EB") @db.VarChar(10)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  scheduleAssignments ScheduleAssignment[]
  salesReports        SalesReport[]
  bonusDetails        BonusDetail[]

  @@map("shifts")
}

model ScheduleAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  date       String   @db.VarChar(10)
  employeeId String   @map("employee_id") @db.Uuid
  shiftId    String   @map("shift_id") @db.Uuid
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  employee   Employee    @relation(fields: [employeeId], references: [id])
  shift      Shift       @relation(fields: [shiftId], references: [id])
  attendance Attendance?

  @@unique([date, employeeId, shiftId])
  @@map("schedule_assignments")
}

model Attendance {
  id                   String           @id @default(uuid()) @db.Uuid
  scheduleAssignmentId String           @unique @map("schedule_assignment_id") @db.Uuid
  checkInAt            DateTime         @map("check_in_at") @db.Timestamptz
  status               AttendanceStatus
  lateMinutes          Int              @default(0) @map("late_minutes")
  selfieFileId         String?          @map("selfie_file_id") @db.Uuid
  notes                String?
  rateSnapshot         BigInt           @default(0) @map("rate_snapshot")
  correctedBy          String?          @map("corrected_by") @db.Uuid
  correctedAt          DateTime?        @map("corrected_at") @db.Timestamptz
  createdBy            String           @map("created_by") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  scheduleAssignment ScheduleAssignment @relation(fields: [scheduleAssignmentId], references: [id])
  selfieFile         File?              @relation("AttendanceSelfie", fields: [selfieFileId], references: [id])

  @@map("attendances")
}

model LeaveRequest {
  id              String      @id @default(uuid()) @db.Uuid
  employeeId      String      @map("employee_id") @db.Uuid
  startDate       DateTime    @map("start_date") @db.Date
  endDate         DateTime    @map("end_date") @db.Date
  totalDays       Int         @map("total_days")
  reason          String
  status          LeaveStatus @default(PENDING)
  reviewedBy      String?     @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?   @map("reviewed_at") @db.Timestamptz
  rejectionReason String?     @map("rejection_reason")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("leave_requests")
}

model SalesReport {
  id                    String            @id @default(uuid()) @db.Uuid
  reportDate            DateTime          @map("report_date") @db.Date
  shiftId               String            @map("shift_id") @db.Uuid
  submittedByEmployeeId String            @map("submitted_by_employee_id") @db.Uuid
  grossSales            BigInt            @map("gross_sales")
  netSales              BigInt            @map("net_sales")
  transactionCount      Int               @default(0) @map("transaction_count")
  notes                 String?
  status                SalesReportStatus @default(DRAFT)
  submittedAt           DateTime?         @map("submitted_at") @db.Timestamptz
  verifiedAt            DateTime?         @map("verified_at") @db.Timestamptz
  verifiedBy            String?           @map("verified_by") @db.Uuid
  rejectionReason       String?           @map("rejection_reason")
  scheduleAssignmentId  String?           @map("schedule_assignment_id") @db.Uuid
  createdBy             String            @map("created_by") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  submittedByEmployee Employee      @relation(fields: [submittedByEmployeeId], references: [id])
  shift               Shift         @relation(fields: [shiftId], references: [id])
  bonusDetails        BonusDetail[]

  @@map("sales_reports")
}

model BonusPolicy {
  id                String    @id @default(uuid()) @db.Uuid
  thresholdAmount   BigInt    @map("threshold_amount")
  bonusPerThreshold BigInt    @map("bonus_per_threshold")
  effectiveFrom     DateTime  @map("effective_from") @db.Date
  effectiveTo       DateTime? @map("effective_to") @db.Date
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  bonusDetails BonusDetail[]

  @@map("bonus_policies")
}

model BonusDetail {
  id            String   @id @default(uuid()) @db.Uuid
  salesReportId String   @map("sales_report_id") @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  shiftId       String   @map("shift_id") @db.Uuid
  bonusPolicyId String   @map("bonus_policy_id") @db.Uuid
  amount        BigInt
  multiplier    Int
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  salesReport SalesReport @relation(fields: [salesReportId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])
  shift       Shift       @relation(fields: [shiftId], references: [id])
  bonusPolicy BonusPolicy @relation(fields: [bonusPolicyId], references: [id])

  @@unique([salesReportId, employeeId])
  @@map("bonus_details")
}

model Payroll {
  id           String        @id @default(uuid()) @db.Uuid
  employeeId   String        @map("employee_id") @db.Uuid
  year         Int
  month        Int
  shiftsWorked Int           @default(0) @map("shifts_worked")
  shiftPay     BigInt        @default(0) @map("shift_pay")
  sickDays     Int           @default(0) @map("sick_days")
  sickPay      BigInt        @default(0) @map("sick_pay")
  bonusAmount  BigInt        @default(0) @map("bonus_amount")
  adjustments  BigInt        @default(0)
  netSalary    BigInt        @default(0) @map("net_salary")
  status       PayrollStatus @default(DRAFT)
  approvedBy   String?       @map("approved_by") @db.Uuid
  approvedAt   DateTime?     @map("approved_at") @db.Timestamptz
  createdBy    String        @map("created_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  employee Employee  @relation(fields: [employeeId], references: [id])
  payment  Payment?

  @@unique([employeeId, year, month])
  @@map("payrolls")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  payrollId       String        @unique @map("payroll_id") @db.Uuid
  amount          BigInt
  paymentDate     DateTime      @map("payment_date") @db.Timestamptz
  paymentMethod   PaymentMethod @map("payment_method")
  referenceNumber String?       @map("reference_number") @db.VarChar(100)
  proofFileId     String?       @map("proof_file_id") @db.Uuid
  notes           String?
  recordedBy      String        @map("recorded_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  payroll Payroll @relation(fields: [payrollId], references: [id])

  @@map("payments")
}

model Notification {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  title            String           @db.VarChar(150)
  message          String
  notificationType NotificationType @map("notification_type")
  referenceType    String?          @map("reference_type") @db.VarChar(50)
  referenceId      String?          @map("reference_id") @db.Uuid
  readAt           DateTime?        @map("read_at") @db.Timestamptz
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  beforeData Json?    @map("before_data") @db.JsonB
  afterData  Json?    @map("after_data") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@map("audit_logs")
}

model File {
  id           String       @id @default(uuid()) @db.Uuid
  uploadedBy   String       @map("uploaded_by") @db.Uuid
  originalName String       @map("original_name") @db.VarChar(255)
  storageKey   String       @unique @map("storage_key")
  mimeType     String       @map("mime_type") @db.VarChar(100)
  fileSize     BigInt       @map("file_size")
  fileCategory FileCategory @map("file_category")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  uploadedByUser    User         @relation(fields: [uploadedBy], references: [id])
  attendanceSelfies Attendance[] @relation("AttendanceSelfie")
  employeePhotos    Employee[]   @relation("EmployeeProfilePhoto")

  @@map("files")
}

model SystemSetting {
  id           String   @id @default(uuid()) @db.Uuid
  settingKey   String   @unique @map("setting_key") @db.VarChar(100)
  settingValue String   @map("setting_value")
  description  String?
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}
